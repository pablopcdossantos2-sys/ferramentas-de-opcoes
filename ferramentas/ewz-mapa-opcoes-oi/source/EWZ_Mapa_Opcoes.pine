//@version=6
indicator("EWZ | Mapa de opções: OI e financeiro", shorttitle = "EWZ Opções", overlay = true, max_boxes_count = 150)

// Versão 1.0. Dados MANUAIS: não consulta cadeia de opções ou API externa.
// Cole no Pine Editor, salve e adicione ao gráfico de EWZ em USD.
// Configurações > 1. Dados: cole UMA série de opção por linha, sem cabeçalho:
// vencimento;tipo;strike;oi;premio;multiplicador
// Exemplo FICTÍCIO: 2099-12-18;C;35;1000;1.20;100
// Tipo C ou P. Decimais com ponto, sem separadores de milhar.
// Prêmio em USD por cota; NA se indisponível. OI em contratos, sem dobrar lados.
// Use somente séries padrão de EWZ, com o mesmo entregável. Não misture ajustadas.
// Atualize o texto e sua data manualmente; o gráfico é um retrato estático.
// Valor pelo prêmio = soma(OI * prêmio * multiplicador).
// Nocional pelo strike = soma(OI * strike * multiplicador).
// Nenhuma dessas medidas representa volume financeiro efetivamente negociado,
// margem, exposição líquida dos dealers, GEX ou suporte/resistência garantidos.
// Referências: tradingview.com/pine-script-docs/concepts/other-timeframes-and-data/
// optionseducation.org/optionsoverview/options-basics

const string G_DATA = "1. Dados de opções — atualização manual"
const string G_FILTER = "2. Agrupamento e vencimentos"
const string G_VIEW = "3. Gráfico e quadro"
const int MAX_ROWS = 1000
const int MAX_BANDS = 120
const string DEMO = "2099-12-18;C;33;300;2.50;100\n2099-12-18;P;33;2500;0.45;100\n2099-12-18;C;34;800;1.80;100\n2099-12-18;P;34;4000;0.75;100\n2099-12-18;C;35;2200;1.20;100\n2099-12-18;P;35;2100;1.15;100\n2099-12-18;C;36;5000;0.70;100\n2099-12-18;P;36;900;1.80;100\n2099-12-18;C;37;3500;0.35;100\n2099-12-18;P;37;400;2.50;100\n2100-01-15;C;35;500;1.60;100\n2100-01-15;P;35;600;1.55;100"

bool demoMode = input.bool(false, "Demonstração — dados FICTÍCIOS", group = G_DATA)
string dataInput = input.text_area("", "Cole as séries de opções", tooltip = "Sem cabeçalho. Uma linha por série:\nvencimento;C ou P;strike;OI;prêmio;mult\nExemplo fictício: 2099-12-18;C;35;1000;1.20;100\nDatas AAAA-MM-DD. Prêmio em USD/cota. NA se ausente. Máximo 1.000 linhas e 120 faixas.", group = G_DATA)
string snapshotInput = input.string("", "Data de referência do OI (AAAA-MM-DD)", tooltip = "Obrigatória ao inserir dados reais. Use a data efetiva do OI informada pela fonte, não apenas a data do download.", group = G_DATA)
string sourceInput = input.string("Fonte não informada", "Fonte / horário dos prêmios", group = G_DATA)

float bandWidth = input.float(1.0, "Largura da faixa (USD)", minval = 0.01, step = 0.5, group = G_FILTER)
string expiryFromInput = input.string("", "Vencimento inicial — vazio = sem limite", group = G_FILTER)
string expiryToInput = input.string("", "Vencimento final — vazio = sem limite", group = G_FILTER)
bool excludeExpired = input.bool(true, "Excluir vencimentos anteriores à data do OI", group = G_FILTER)
string metric = input.string("Valor pelo prêmio", "Valor financeiro no quadro", options = ["Valor pelo prêmio", "Nocional pelo strike"], group = G_FILTER)

bool showBands = input.bool(true, "Desenhar faixas", group = G_VIEW)
bool showBandText = input.bool(true, "Mostrar OI nas faixas", group = G_VIEW)
int projectionBars = input.int(70, "Extensão à direita (barras)", minval = 10, maxval = 300, group = G_VIEW)
int rowsPerPage = input.int(12, "Faixas por página do quadro", minval = 5, maxval = 20, group = G_VIEW)
int pageInput = input.int(1, "Página do quadro", minval = 1, maxval = 24, group = G_VIEW)
string positionInput = input.string("Superior esquerdo", "Posição do quadro", options = ["Superior esquerdo", "Superior direito", "Inferior esquerdo", "Inferior direito"], group = G_VIEW)
bool compactValues = input.bool(true, "Abreviar USD: K = mil; M = milhão", group = G_VIEW)
color callColor = input.color(color.rgb(246, 157, 66), "Calls", group = G_VIEW)
color putColor = input.color(color.rgb(52, 175, 226), "Puts", group = G_VIEW)

type Band
    float callOI = 0.0
    float putOI = 0.0
    float callPremium = 0.0
    float putPremium = 0.0
    float callNotional = 0.0
    float putNotional = 0.0
    bool callMissing = false
    bool putMissing = false

// Valida calendário, inclusive anos bissextos. Retorna AAAAMMDD ou zero.
dateKey(string raw) =>
    string s = str.trim(raw)
    int result = 0
    if str.length(s) == 10
        bool shapeOK = str.substring(s, 4, 5) == "-" and str.substring(s, 7, 8) == "-"
        for p = 0 to 9
            if p != 4 and p != 7
                shapeOK := shapeOK and str.contains("0123456789", str.substring(s, p, p + 1))
        if shapeOK
            int y = int(str.tonumber(str.substring(s, 0, 4)))
            int m = int(str.tonumber(str.substring(s, 5, 7)))
            int d = int(str.tonumber(str.substring(s, 8, 10)))
            bool leap = y % 400 == 0 or (y % 4 == 0 and y % 100 != 0)
            int days = m == 2 ? (leap ? 29 : 28) : (m == 4 or m == 6 or m == 9 or m == 11 ? 30 : 31)
            if y >= 1970 and y <= 2199 and m >= 1 and m <= 12 and d >= 1 and d <= days
                result := y * 10000 + m * 100 + d
    result

money(float value) =>
    string result = "N/D"
    if not na(value)
        if compactValues and value >= 1000000000
            result := "$" + str.tostring(value / 1000000000, "0.00") + "B"
        else if compactValues and value >= 1000000
            result := "$" + str.tostring(value / 1000000, "0.00") + "M"
        else if compactValues and value >= 1000
            result := "$" + str.tostring(value / 1000, "0.00") + "K"
        else
            result := "$" + str.tostring(value, "#,##0.00")
    result

contracts(float value) =>
    str.tostring(value, "#,##0")

ratio(float puts, float calls) =>
    calls > 0 ? str.tostring(puts / calls, "0.00") : "N/D"

financial(Band b, bool isCall) =>
    float result = na
    if metric == "Nocional pelo strike"
        result := isCall ? b.callNotional : b.putNotional
    else
        result := isCall ? (b.callMissing ? na : b.callPremium) : (b.putMissing ? na : b.putPremium)
    result

addContract(Band b, bool isCall, float oi, float premium, float strike, float mult) =>
    if isCall
        b.callOI += oi
        b.callPremium += na(premium) ? 0.0 : oi * premium * mult
        b.callNotional += oi * strike * mult
        b.callMissing := b.callMissing or (oi > 0 and na(premium))
    else
        b.putOI += oi
        b.putPremium += na(premium) ? 0.0 : oi * premium * mult
        b.putNotional += oi * strike * mult
        b.putMissing := b.putMissing or (oi > 0 and na(premium))

writeCell(table t, int col, int row, string value, color bg, color fg) =>
    table.cell(t, col, row, value, bgcolor = bg, text_color = fg, text_size = size.small)

var array<int> keys = array.new<int>()
var array<Band> bands = array.new<Band>()
var map<int, int> bandIndex = map.new<int, int>()
var map<string, bool> seen = map.new<string, bool>()
var array<int> sorted = array.new<int>()
var array<box> drawings = array.new<box>()
var Band totals = Band.new()
var int imported = 0
var int filtered = 0
var int emptyOI = 0
var int missingQuotes = 0
var int used = 0
var float maximumOI = 0.0

string snapshot = demoMode ? "2099-12-01" : str.trim(snapshotInput)
string source = demoMode ? "EXEMPLO FICTÍCIO — sem dados de mercado" : sourceInput
string rawData = demoMode ? DEMO : dataInput
bool hasData = str.length(str.trim(rawData)) > 0
bool isEWZ = syminfo.ticker == "EWZ" and syminfo.currency == "USD"

string tablePosition = switch positionInput
    "Superior direito" => position.top_right
    "Inferior esquerdo" => position.bottom_left
    "Inferior direito" => position.bottom_right
    => position.top_left

var table panel = table.new(tablePosition, 7, rowsPerPage + 7, bgcolor = color.rgb(18, 26, 38), border_width = 1, border_color = color.rgb(49, 60, 75))

if barstate.isfirst
    // Células mescladas para cabeçalho, origem, filtros e notas.
    table.merge_cells(panel, 0, 0, 6, 0)
    table.merge_cells(panel, 0, 1, 6, 1)
    table.merge_cells(panel, 0, 2, 6, 2)
    table.merge_cells(panel, 0, rowsPerPage + 5, 6, rowsPerPage + 5)
    table.merge_cells(panel, 0, rowsPerPage + 6, 6, rowsPerPage + 6)
    if not isEWZ
        runtime.error("Aplique este indicador ao gráfico de EWZ cotado em USD.")
    int refDate = dateKey(snapshot)
    string fromText = str.trim(expiryFromInput)
    string toText = str.trim(expiryToInput)
    int fromDate = fromText == "" ? 0 : dateKey(fromText)
    int toDate = toText == "" ? 21991231 : dateKey(toText)
    if hasData and refDate == 0
        runtime.error("Preencha a data de referência do OI com uma data válida: AAAA-MM-DD.")
    if (fromText != "" and fromDate == 0) or (toText != "" and toDate == 0) or fromDate > toDate
        runtime.error("Revise os filtros de vencimento: datas AAAA-MM-DD e início <= fim.")
    if str.length(rawData) > 60000
        runtime.error("Texto acima de 60.000 caracteres. Reduza o conjunto de vencimentos.")
    if hasData
        array<string> lines = str.split(str.replace_all(rawData, "\r", ""), "\n")
        if array.size(lines) > MAX_ROWS
            runtime.error("Limite de 1.000 linhas. Reduza o conjunto de vencimentos.")
        for rowNumber = 0 to array.size(lines) - 1
            string rowText = str.trim(array.get(lines, rowNumber))
            if rowText != ""
                string prefix = "Linha " + str.tostring(rowNumber + 1) + ": "
                array<string> fields = str.split(rowText, ";")
                if array.size(fields) != 6
                    runtime.error(prefix + "use vencimento;tipo;strike;oi;premio;multiplicador, sem cabeçalho.")
                string expiryText = str.trim(array.get(fields, 0))
                string kind = str.upper(str.trim(array.get(fields, 1)))
                float strike = str.tonumber(str.trim(array.get(fields, 2)))
                float oi = str.tonumber(str.trim(array.get(fields, 3)))
                string premiumText = str.upper(str.trim(array.get(fields, 4)))
                float premium = str.tonumber(premiumText)
                float mult = str.tonumber(str.trim(array.get(fields, 5)))
                int expiryDate = dateKey(expiryText)
                if expiryDate == 0 or (kind != "C" and kind != "P")
                    runtime.error(prefix + "vencimento inválido ou tipo diferente de C/P.")
                if na(strike) or strike <= 0 or strike > 10000
                    runtime.error(prefix + "strike deve ser positivo e <= 10000; use ponto decimal.")
                if na(oi) or oi < 0 or oi != math.floor(oi) or oi > 1000000000
                    runtime.error(prefix + "OI deve ser inteiro entre 0 e 1.000.000.000, sem separador de milhar.")
                if (premiumText != "NA" and (na(premium) or premium < 0 or premium > 1000000))
                    runtime.error(prefix + "prêmio deve ser >= 0, com ponto decimal, ou NA se ausente.")
                if na(mult) or mult <= 0 or mult != math.floor(mult) or mult > 100000
                    runtime.error(prefix + "multiplicador deve ser inteiro positivo e <= 100000.")
                // Identidade de série padrão: mesmo vencimento, tipo e strike.
                string identity = expiryText + "|" + kind + "|" + str.tostring(strike, "0.########")
                if map.contains(seen, identity)
                    runtime.error(prefix + "série duplicada. Use uma única linha por vencimento/tipo/strike.")
                map.put(seen, identity, true)
                imported += 1
                bool included = expiryDate >= fromDate and expiryDate <= toDate and (not excludeExpired or expiryDate >= refDate)
                if not included
                    filtered += 1
                else if oi == 0
                    emptyOI += 1
                else
                    // Limite inferior inclusivo; limite superior exclusivo.
                    // Epsilon evita empurrar um strike na fronteira para a faixa anterior.
                    int bucket = int(math.floor(strike / bandWidth + 0.000000001))
                    if not map.contains(bandIndex, bucket)
                        if array.size(bands) >= MAX_BANDS
                            runtime.error("Mais de 120 faixas. Aumente sua largura ou restrinja vencimentos.")
                        map.put(bandIndex, bucket, array.size(bands))
                        array.push(keys, bucket)
                        array.push(bands, Band.new())
                    Band b = array.get(bands, map.get(bandIndex, bucket))
                    addContract(b, kind == "C", oi, premium, strike, mult)
                    addContract(totals, kind == "C", oi, premium, strike, mult)
                    used += 1
                    if na(premium)
                        missingQuotes += 1
        sorted := array.sort_indices(keys, order.ascending)
        if array.size(bands) > 0
            for b in bands
                maximumOI := math.max(maximumOI, b.callOI + b.putOI)

if barstate.islast
    while array.size(drawings) > 0
        box.delete(array.pop(drawings))
    int bandCount = array.size(bands)
    int pages = math.max(1, int(math.ceil(float(bandCount) / rowsPerPage)))
    int currentPage = math.min(pageInput, pages)
    int firstIndex = (currentPage - 1) * rowsPerPage
    color dark = color.rgb(18, 26, 38)
    color header = color.rgb(34, 46, 62)
    color muted = color.rgb(183, 195, 208)
    color white = color.white
    string title = demoMode ? "EWZ | DEMONSTRAÇÃO — DADOS FICTÍCIOS" : "EWZ | OPÇÕES EM ABERTO — DADOS MANUAIS"
    writeCell(panel, 0, 0, title, demoMode ? color.rgb(134, 77, 13) : header, white)
    writeCell(panel, 0, 1, "OI: " + (hasData ? snapshot : "sem dados") + " | " + source, dark, muted)
    string expiryRange = (str.trim(expiryFromInput) == "" ? "todos" : str.trim(expiryFromInput)) + " até " + (str.trim(expiryToInput) == "" ? "todos" : str.trim(expiryToInput))
    writeCell(panel, 0, 2, metric + " (USD) | venc.: " + expiryRange + " | pág. " + str.tostring(currentPage) + "/" + str.tostring(pages), dark, white)
    writeCell(panel, 0, 3, "Faixa [início, fim)", header, white)
    writeCell(panel, 1, 3, "OI call", header, callColor)
    writeCell(panel, 2, 3, "OI put", header, putColor)
    writeCell(panel, 3, 3, "Call USD", header, callColor)
    writeCell(panel, 4, 3, "Put USD", header, putColor)
    writeCell(panel, 5, 3, "Total USD", header, white)
    writeCell(panel, 6, 3, "P/C OI", header, white)
    for r = 0 to rowsPerPage - 1
        for c = 0 to 6
            writeCell(panel, c, r + 4, "", dark, white)
    if bandCount > 0
        for rank = 0 to bandCount - 1
            int idx = array.get(sorted, rank)
            Band b = array.get(bands, idx)
            float lower = array.get(keys, idx) * bandWidth
            float upper = lower + bandWidth
            float callValue = financial(b, true)
            float putValue = financial(b, false)
            float combinedOI = b.callOI + b.putOI
            color blend = color.from_gradient(b.callOI / combinedOI, 0, 1, putColor, callColor)
            int transparency = int(92 - 35 * combinedOI / maximumOI)
            string rangeText = str.tostring(lower, "0.00####") + "–" + str.tostring(upper, "0.00####")
            if showBands
                string bandText = showBandText ? "C " + contracts(b.callOI) + " | P " + contracts(b.putOI) : ""
                box area = box.new(left = bar_index + 1, top = upper, right = bar_index + projectionBars, bottom = lower, xloc = xloc.bar_index, border_color = color.new(blend, 20), border_width = 1, bgcolor = color.new(blend, transparency), text = bandText, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
                array.push(drawings, area)
            if rank >= firstIndex and rank < firstIndex + rowsPerPage
                int row = rank - firstIndex + 4
                bool atPrice = close >= lower and close < upper
                color rowBG = atPrice ? color.rgb(52, 62, 78) : dark
                writeCell(panel, 0, row, (atPrice ? "> " : "") + rangeText, rowBG, white)
                writeCell(panel, 1, row, contracts(b.callOI), rowBG, callColor)
                writeCell(panel, 2, row, contracts(b.putOI), rowBG, putColor)
                writeCell(panel, 3, row, money(callValue), rowBG, callColor)
                writeCell(panel, 4, row, money(putValue), rowBG, putColor)
                writeCell(panel, 5, row, money(callValue + putValue), rowBG, white)
                writeCell(panel, 6, row, ratio(b.putOI, b.callOI), rowBG, muted)
    else
        writeCell(panel, 0, 4, hasData ? "Sem OI nos filtros" : "Cole dados nas configurações", dark, color.orange)
    int totalRow = rowsPerPage + 4
    float allCalls = financial(totals, true)
    float allPuts = financial(totals, false)
    writeCell(panel, 0, totalRow, "TOTAL — todas as páginas", header, white)
    writeCell(panel, 1, totalRow, contracts(totals.callOI), header, callColor)
    writeCell(panel, 2, totalRow, contracts(totals.putOI), header, putColor)
    writeCell(panel, 3, totalRow, hasData ? money(allCalls) : "N/D", header, callColor)
    writeCell(panel, 4, totalRow, hasData ? money(allPuts) : "N/D", header, putColor)
    writeCell(panel, 5, totalRow, hasData ? money(allCalls + allPuts) : "N/D", header, white)
    writeCell(panel, 6, totalRow, ratio(totals.putOI, totals.callOI), header, white)
    string stats = str.tostring(bandCount) + " faixas | séries usadas " + str.tostring(used) + "/" + str.tostring(imported) + " | filtradas " + str.tostring(filtered) + " | OI zero " + str.tostring(emptyOI)
    writeCell(panel, 0, rowsPerPage + 5, stats, dark, muted)
    string note = missingQuotes > 0 and metric == "Valor pelo prêmio" ? "N/D: prêmio ausente em " + str.tostring(missingQuotes) + " séries; OI preservado." : "Cor: calls laranja / puts azul; intensidade = OI total."
    writeCell(panel, 0, rowsPerPage + 6, note + "\nRetrato estático; não é volume negociado nem histórico.", dark, muted)