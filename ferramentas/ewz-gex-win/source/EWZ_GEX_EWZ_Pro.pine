//@version=6
indicator("EWZ GEX — Níveis Barchart", overlay = true, max_labels_count = 100)

// 1) Bloco produzido pela aplicação desktop.
groupBridge = "1. Aplicação desktop"
levelInputMode = input.string("Bloco do aplicativo", "Origem dos níveis", options = ["Bloco do aplicativo", "Manual individual"], group = groupBridge)
appBlock = input.string("", "Bloco EWZGEX1", group = groupBridge, tooltip = "Cole aqui, nas Configurações do indicador, o bloco EWZGEX1. Não cole o bloco no código Pine.")
bool appBlockOk = str.startswith(appBlock, "EWZGEX1|")

f_blockFloat(string key, float fallback) =>
    float out = fallback
    if appBlockOk
        parts = str.split(appBlock, "|")
        for i = 0 to array.size(parts) - 1
            token = array.get(parts, i)
            kv = str.split(token, "=")
            if array.size(kv) >= 2 and array.get(kv, 0) == key
                parsed = str.tonumber(array.get(kv, 1))
                if not na(parsed)
                    out := parsed
    out

// 2) Níveis GEX do próprio EWZ.
groupGex = "2. Níveis GEX do EWZ"
showTeto = input.bool(true, "", inline = "teto", group = groupGex)
tetoManual = input.float(0.0, "Call/Put teto", minval = 0.0, step = 0.01, inline = "teto", group = groupGex)
showCall2 = input.bool(true, "", inline = "cw2", group = groupGex)
call2Manual = input.float(0.0, "Call Wall 2", minval = 0.0, step = 0.01, inline = "cw2", group = groupGex)
showCall1 = input.bool(true, "", inline = "cw1", group = groupGex)
call1Manual = input.float(0.0, "Call Wall 1", minval = 0.0, step = 0.01, inline = "cw1", group = groupGex)
showGammaRes = input.bool(true, "", inline = "gres", group = groupGex)
gammaResManual = input.float(0.0, "Gamma resistência", minval = 0.0, step = 0.01, inline = "gres", group = groupGex)
showGammaFlip = input.bool(true, "", inline = "flip", group = groupGex)
gammaFlipManual = input.float(0.0, "Gamma Flip", minval = 0.0, step = 0.01, inline = "flip", group = groupGex)
showGammaSup = input.bool(true, "", inline = "gsup", group = groupGex)
gammaSupManual = input.float(0.0, "Gamma suporte", minval = 0.0, step = 0.01, inline = "gsup", group = groupGex)
showPut2 = input.bool(true, "", inline = "pw2", group = groupGex)
put2Manual = input.float(0.0, "Put Wall 2", minval = 0.0, step = 0.01, inline = "pw2", group = groupGex)
showFloor = input.bool(true, "", inline = "floor", group = groupGex)
floorManual = input.float(0.0, "Put Wall chão", minval = 0.0, step = 0.01, inline = "floor", group = groupGex)

bool useBlock = levelInputMode == "Bloco do aplicativo" and appBlockOk
teto = useBlock ? f_blockFloat("teto", 0.0) : tetoManual
call2 = useBlock ? f_blockFloat("cw2", 0.0) : call2Manual
call1 = useBlock ? f_blockFloat("cw1", 0.0) : call1Manual
gammaRes = useBlock ? f_blockFloat("gres", 0.0) : gammaResManual
gammaFlip = useBlock ? f_blockFloat("flip", 0.0) : gammaFlipManual
gammaSup = useBlock ? f_blockFloat("gsup", 0.0) : gammaSupManual
put2 = useBlock ? f_blockFloat("pw2", 0.0) : put2Manual
floor = useBlock ? f_blockFloat("floor", 0.0) : floorManual

// 3) Visualização direta no gráfico do EWZ, sem projeção.
groupVisual = "3. Visual"
showLines = input.bool(true, "Mostrar linhas no gráfico do EWZ", group = groupVisual)
showLabels = input.bool(true, "Mostrar nomes e preços", group = groupVisual)
showTable = input.bool(true, "Mostrar painel", group = groupVisual)
labelOffset = input.int(2, "Deslocamento dos rótulos", minval = 0, maxval = 50, group = groupVisual)
recentOnly = input.bool(false, "Exibir somente barras recentes", group = groupVisual)
recentDays = input.int(3, "Dias corridos exibidos", minval = 1, maxval = 30, group = groupVisual)
bool inWindow = not recentOnly or time >= timenow - recentDays * 24 * 60 * 60 * 1000

f_valid(float x) => not na(x) and x > 0
f_level(bool enabled, float x) => enabled and inWindow and f_valid(x) ? x : na

lTeto = f_level(showTeto, teto)
lCall2 = f_level(showCall2, call2)
lCall1 = f_level(showCall1, call1)
lGammaRes = f_level(showGammaRes, gammaRes)
lGammaFlip = f_level(showGammaFlip, gammaFlip)
lGammaSup = f_level(showGammaSup, gammaSup)
lPut2 = f_level(showPut2, put2)
lFloor = f_level(showFloor, floor)

plot(showLines ? lTeto : na, "EWZ — Call/Put teto", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(showLines ? lCall2 : na, "EWZ — Call Wall 2", color = color.new(color.red, 25), linewidth = 2, style = plot.style_linebr)
plot(showLines ? lCall1 : na, "EWZ — Call Wall 1", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showLines ? lGammaRes : na, "EWZ — Gamma resistência", color = color.fuchsia, linewidth = 2, style = plot.style_linebr)
plot(showLines ? lGammaFlip : na, "EWZ — Gamma Flip", color = color.yellow, linewidth = 3, style = plot.style_linebr)
plot(showLines ? lGammaSup : na, "EWZ — Gamma suporte", color = color.aqua, linewidth = 2, style = plot.style_linebr)
plot(showLines ? lPut2 : na, "EWZ — Put Wall 2", color = color.new(color.green, 25), linewidth = 2, style = plot.style_linebr)
plot(showLines ? lFloor : na, "EWZ — Put Wall chão", color = color.green, linewidth = 3, style = plot.style_linebr)

f_label(label id, float y, string name, color c) =>
    label out = id
    if barstate.islast
        if showLabels and not na(y)
            string txt = name + " · EWZ " + str.tostring(y, format.mintick)
            if na(out)
                out := label.new(bar_index + labelOffset, y, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 10), textcolor = color.white, size = size.small)
            else
                label.set_xy(out, bar_index + labelOffset, y)
                label.set_text(out, txt)
                label.set_color(out, color.new(c, 10))
        else
            if not na(out)
                label.delete(out)
            out := na
    out

var label a = na
var label b = na
var label c = na
var label d = na
var label e = na
var label f = na
var label g = na
var label h = na
a := f_label(a, lTeto, "Teto", color.red)
b := f_label(b, lCall2, "Call Wall 2", color.red)
c := f_label(c, lCall1, "Call Wall 1", color.orange)
d := f_label(d, lGammaRes, "Gamma Resist.", color.fuchsia)
e := f_label(e, lGammaFlip, "Gamma Flip", color.yellow)
f := f_label(f, lGammaSup, "Gamma Suporte", color.aqua)
g := f_label(g, lPut2, "Put Wall 2", color.green)
h := f_label(h, lFloor, "Put Wall chão", color.green)

var table panel = table.new(position.top_right, 3, 10, border_width = 1)
f_row(int row, string name, float level, color clr) =>
    table.cell(panel, 0, row, name, text_color = clr)
    table.cell(panel, 1, row, f_valid(level) ? str.tostring(level, "#.##") : "—")
    table.cell(panel, 2, row, f_valid(level) ? str.tostring((close / level - 1.0) * 100.0, "#.##") + "%" : "—")

if barstate.islast
    table.clear(panel, 0, 0, 2, 9)
    if showTable
        table.cell(panel, 0, 0, "Nível")
        table.cell(panel, 1, 0, "EWZ")
        table.cell(panel, 2, 0, "Dist. atual")
        table.cell(panel, 0, 1, "Preço atual")
        table.cell(panel, 1, 1, str.tostring(close, format.mintick))
        table.cell(panel, 2, 1, appBlockOk ? "EWZGEX1 ✓" : "manual")
        f_row(2, "Call/Put teto", teto, color.red)
        f_row(3, "Call Wall 2", call2, color.red)
        f_row(4, "Call Wall 1", call1, color.orange)
        f_row(5, "Gamma Resist.", gammaRes, color.fuchsia)
        f_row(6, "Gamma Flip", gammaFlip, color.yellow)
        f_row(7, "Gamma Suporte", gammaSup, color.aqua)
        f_row(8, "Put Wall 2", put2, color.green)
        f_row(9, "Put Wall chão", floor, color.green)

bool chartIsEwz = str.upper(syminfo.ticker) == "EWZ"
bgcolor(not chartIsEwz ? color.new(color.orange, 92) : na, title = "Aviso: gráfico diferente de EWZ")

groupAlerts = "4. Alertas"
proximityPct = input.float(0.10, "Zona de proximidade (%)", minval = 0.01, maxval = 5.0, step = 0.01, group = groupAlerts)
f_near(float level) => f_valid(level) and math.abs(close / level - 1.0) * 100.0 <= proximityPct
bool nearAny = f_near(lTeto) or f_near(lCall2) or f_near(lCall1) or f_near(lGammaRes) or f_near(lGammaFlip) or f_near(lGammaSup) or f_near(lPut2) or f_near(lFloor)
alertcondition(nearAny and not nearAny[1], "EWZ próximo de nível GEX", "O EWZ entrou na zona de proximidade de um nível GEX.")
alertcondition(ta.cross(close, lCall1), "EWZ cruzou Call Wall 1", "O EWZ cruzou a Call Wall 1.")
alertcondition(ta.cross(close, lGammaFlip), "EWZ cruzou Gamma Flip", "O EWZ cruzou o Gamma Flip.")
alertcondition(ta.cross(close, lFloor), "EWZ cruzou Put Wall chão", "O EWZ cruzou a Put Wall chão.")
